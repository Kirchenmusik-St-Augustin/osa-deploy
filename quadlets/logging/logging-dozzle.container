[Unit]
Description=Dozzle Log Viewer
After=podman.socket
Requires=podman.socket

[Container]
ContainerName=logging-dozzle
# Pinned to a specific, verified digest instead of the floating ":latest"
# tag -- with no AutoUpdate= label, ":latest" otherwise means "whatever
# amir20/dozzle happened to push on first pull, forever" (no updates at
# all) or, if AutoUpdate= were ever added later, "whatever gets pushed
# next, sight unseen". Neither is acceptable for an image holding full
# Podman-socket access to every other rootless container this user runs
# (see the Volume= line below). Bumping Dozzle is now a deliberate,
# manual edit.
Image=docker.io/amir20/dozzle:v11.4.3@sha256:b3678f02393afa2778f03ee8293909485a59882a8194a5351192f66a9b337035

# Read-only only protects the socket file itself. Every API call is still
# possible through it, including creating privileged containers. The viewer is
# therefore reachable only through the authenticated route of the Caddyfile.
Volume=%t/podman/podman.sock:/var/run/docker.sock:ro
# On hosts that enforce SELinux a confined container may not connect to the
# Podman socket, so the label confinement is switched off for this one
# container. It already holds the whole Podman API through that socket, so the
# label adds no isolation here. Other hosts have no label enforcement and are
# unaffected. No relabelling (:z) of the socket: that would change the label of
# the host's own socket.
SecurityLabelDisable=true

PublishPort=127.0.0.1:8081:8080
Environment=DOZZLE_NO_ANALYTICS=true
# A pure log viewer. Without a writable /data every start counts as a fresh
# install, and Dozzle 11 would open its setup wizard each time (own login,
# data volume, container actions and shell, Dozzle Cloud, auto-update). The
# wizard needs Dozzle 11.2 or later. Actions and shell are off by default;
# they are set explicitly so a changed default upstream cannot switch them on.
# The image is pinned, so Dozzle neither looks for new releases of itself nor
# checks the registries for newer images of the other containers.
Environment=DOZZLE_DISABLE_SETUP_WIZARD=true
Environment=DOZZLE_ENABLE_ACTIONS=false
Environment=DOZZLE_ENABLE_SHELL=false
Environment=DOZZLE_RELEASE_CHECK_MODE=manual
Environment=DOZZLE_IMAGE_CHECK_MODE=off
Environment=TZ=Europe/Vienna

ReadOnly=true
NoNewPrivileges=true

DropCapability=all

# The VPS this runs on has 1.9GB total RAM across all 7 application
# containers -- an unbounded container could starve every neighbor on an
# OOM event. 64m is ~6x the observed idle RSS (roughly 10MB); Dozzle only
# streams logs to a small, admin-only audience via the socket mount
# above. Quadlet 5.4.2's [Container] section has no native memory-limit
# key, so PodmanArgs= is the only way to reach --memory. 32 PIDs covers
# its log-tailing goroutine pool with headroom.
PodmanArgs=--memory=64m
PidsLimit=32

Mount=type=tmpfs,target=/tmp,tmpfs-mode=1777,noexec

# --- Health check ---
Notify=healthy
HealthCmd=CMD /dozzle healthcheck
HealthInterval=10s
HealthRetries=3
HealthTimeout=2s
HealthStartPeriod=5s

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
