# Template for secrets/osa-frontend.env -- copy, fill in, then
# `ansible-vault encrypt secrets/osa-frontend.env`. This .example file
# itself is safe to commit (no real secrets in it).
#
#   cp secrets/osa-frontend.env.example secrets/osa-frontend.env
#   $EDITOR secrets/osa-frontend.env
#   ansible-vault encrypt secrets/osa-frontend.env

# Required -- the image's docker-entrypoint.d/40-generate-runtime-config.sh
# refuses to start nginx without these two (see osa-frontend/docker/
# docker-entrypoint.d/). Relative path, not a same-origin assumption
# elsewhere in the code -- the API base URL must stay configurable,
# never hardcoded.
API_BASE_URL=/api
APP_ENVIRONMENT=production

# Optional -- graceful no-op (Google button just doesn't render) when
# unset. Same value as osa-backend.env's GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
