# Template for secrets/<stage>/caddy.env -- copy, fill in, then
# `ansible-vault encrypt secrets/<stage>/caddy.env`. This .example file
# itself is safe to commit (no real secrets in it).
#
#   cp secrets/<stage>/caddy.env.example secrets/<stage>/caddy.env
#   $EDITOR secrets/<stage>/caddy.env
#   ansible-vault encrypt secrets/<stage>/caddy.env
#
# Generate a fresh LOGGING_USER/LOGGING_PASSWORD_HASH per stage -- never
# reuse another stage's, so a leaked non-production Dozzle login can't
# double as a production one. LOGGING_PASSWORD_HASH is a bcrypt hash. Run
# this interactively: Caddy asks for the password twice without echoing it,
# so it never appears in the process list or the shell history:
#   podman run -it --rm docker.io/library/caddy:2.11 caddy hash-password --algorithm bcrypt --bcrypt-cost 14

LOGGING_USER=
LOGGING_PASSWORD_HASH=
