# Template for secrets/<stage>/osa-backend.env.j2 -- copy this file, fill
# in the placeholders below, then
# `ansible-vault encrypt secrets/<stage>/osa-backend.env.j2` before it is
# ever committed for real. This .example file itself is safe to commit (no
# real secrets in it).
#
# Domain- and stage-shaped values below are Jinja2 expressions
# (backend_domain/frontend_domain/shorturl_domain/app_environment), filled
# in from the matching inventory/<stage>.ini at deploy time --
# ansible.builtin.template decrypts vault content before rendering, so
# editing stays a plain ansible-vault workflow:
#
#   cp secrets/<stage>/osa-backend.env.j2.example secrets/<stage>/osa-backend.env.j2
#   $EDITOR secrets/<stage>/osa-backend.env.j2
#   ansible-vault encrypt secrets/<stage>/osa-backend.env.j2

APP_ENVIRONMENT={{ app_environment }}

CORS_ORIGINS=https://{{ frontend_domain }}

# Points at the osa-backend-pg sidecar container in the same pod (see
# templates/osa-backend-pg.container.j2) -- password must match that
# container's POSTGRES_PASSWORD in secrets/<stage>/osa-backend-pg.env.
DATABASE_URL=postgresql://osa:CHANGEME@127.0.0.1:5432/osa

# Points at the osa-backend-valkey sidecar container in the same pod
# (see templates/osa-backend-valkey.container.j2) -- password must
# match that container's VALKEY_PASSWORD in
# secrets/<stage>/osa-backend-valkey.env.
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
VALKEY_PASSWORD=CHANGEME

# JWT signing secret -- must be at least 32 characters, unique per stage.
# Generate a real value with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Session/JWT lifetimes and password policy -- Tier 2, safe to leave
# commented out (defaults from app/core/config.py apply).
# SESSION_LIFETIME_MINUTES=15
# SESSION_IDLE_TIMEOUT_MINUTES=120
# REFRESH_TOKEN_LIFETIME_DAYS=7
# PASSWORD_MIN_LENGTH=8

APP_TIMEZONE=Europe/Vienna

# SMTP transport -- required before the mailer can send anything. Comment
# out all four on non-production stages (no mail sending outside prod) --
# SMTP_PORT is int-typed in app/core/config.py's Settings, so a blank
# value ("SMTP_PORT=" with nothing after it) fails Pydantic validation at
# startup instead of being treated as unset; only a genuinely absent/
# commented-out key does that.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=

# Tier 2 -- safe to leave commented out (defaults match Legacy 1:1).
# SMTP_FROM_EMAIL=no-reply@hochamt.at
# SMTP_FROM_NAME=Kirchenmusik St. Augustin
# MAIL_DISPONENT=einteilung@hochamt.at
# MAIL_KILL_SWITCH_PERIOD_DAYS=30
# MAIL_KILL_SWITCH_THRESHOLD=950
# EMAIL_VERIFICATION_TTL_MINUTES=60
# PASSWORD_RESET_TTL_MINUTES=60

# Google OAuth ID-token audience -- same value as osa-frontend.env.j2's
# GOOGLE_CLIENT_ID below. Leave unset on non-production stages unless a
# matching OAuth client was configured for this stage's domain (Google
# login becomes a graceful no-op when unset).
GOOGLE_CLIENT_ID=

FRONTEND_VERIFY_EMAIL_URL=https://{{ frontend_domain }}/verify-email
FRONTEND_RESET_PASSWORD_URL=https://{{ frontend_domain }}/reset-password

SHORTURL_DOMAIN={{ shorturl_domain }}

# Koofr WebDAV backup -- credentials come from secrets/shared/koofr.yml,
# loaded via playbooks/deploy.yml's vars_files, shared across every stage.
# Nothing to fill in here.
KOOFR_USER={{ koofr_user }}
KOOFR_PASSWORD={{ koofr_password }}

# Tier 2 -- safe to leave commented out (defaults match Legacy 1:1, see
# app/core/config.py's docstring for why these must not change casually).
# KOOFR_BASE_URI=https://app.koofr.net/dav/
# KOOFR_BACKUP_PATH=Koofr/Backups/osa-db
# KOOFR_BACKUP_RETENTION_DAYS=28
# BACKUP_ENABLED=true

# Tier 2 -- safe to leave commented out, but a DELIBERATE deviation from
# Legacy's dailyAt('10:50') (User decision, 2026-08-13): nighttime slot
# instead, Europe/Vienna wall-clock.
# BACKUP_HOUR=3
# BACKUP_MINUTE=0

# Tier 2 -- safe to leave commented out (defaults match Legacy's
# config/osa.php 1:1, already verified stable against this data).
# PERFORMANCE_DEFAULT_LOCATION_ID=1
# PERFORMANCE_DEFAULT_CONDUCTOR_ARTIST_ID=95
