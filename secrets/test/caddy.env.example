# Template for secrets/caddy.env -- copy, fill in, then
# `ansible-vault encrypt secrets/caddy.env`. This .example file itself is
# safe to commit (no real secrets in it).
#
#   cp secrets/caddy.env.example secrets/caddy.env
#   $EDITOR secrets/caddy.env
#   ansible-vault encrypt secrets/caddy.env
#
# IMPORTANT: reuse osa-infrastructure's EXISTING values here verbatim
# (don't regenerate) -- the Dozzle basic-auth login stays unaffected by
# this cutover, no reason to make anyone re-learn a new password.
# LOGGING_PASSWORD_HASH is a bcrypt hash, generate a NEW one only if you
# actually want to change the password:
#   podman run --rm docker.io/library/caddy:2 caddy hash-password --plaintext '<new-password>'

LOGGING_USER=
LOGGING_PASSWORD_HASH=
