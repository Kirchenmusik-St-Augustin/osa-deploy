# Template for secrets/osa-backend.env -- copy this file, fill in the
# placeholders below, then `ansible-vault encrypt secrets/osa-backend.env`
# before it is ever committed for real. This .example file itself is safe
# to commit (no real secrets in it).
#
#   cp secrets/osa-backend.env.example secrets/osa-backend.env
#   $EDITOR secrets/osa-backend.env
#   ansible-vault encrypt secrets/osa-backend.env

APP_ENVIRONMENT=production

CORS_ORIGINS=https://einteilung.hochamt.at

DATABASE_URL=sqlite:////database/database.sqlite

# JWT signing secret -- must be at least 32 characters. Generate a real
# value with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Session/JWT lifetimes and password policy -- Tier 2, safe to leave
# commented out (defaults from app/core/config.py apply).
# SESSION_LIFETIME_MINUTES=15
# SESSION_IDLE_TIMEOUT_MINUTES=120
# REFRESH_TOKEN_LIFETIME_DAYS=7
# PASSWORD_MIN_LENGTH=8

APP_TIMEZONE=Europe/Vienna

# SMTP transport -- required before the mailer can send anything.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Tier 2 -- safe to leave commented out (defaults match Legacy 1:1).
# SMTP_FROM_EMAIL=no-reply@hochamt.at
# SMTP_FROM_NAME=Kirchenmusik St. Augustin
# MAIL_DISPONENT=einteilung@hochamt.at
# MAIL_KILL_SWITCH_PERIOD_DAYS=30
# MAIL_KILL_SWITCH_THRESHOLD=950
# EMAIL_VERIFICATION_TTL_MINUTES=60
# PASSWORD_RESET_TTL_MINUTES=60

# Google OAuth ID-token audience -- same value as osa-frontend.env's
# GOOGLE_CLIENT_ID below (one Google Cloud OAuth client, used by both
# sides). Reuse Legacy's existing prod client ID.
GOOGLE_CLIENT_ID=

FRONTEND_VERIFY_EMAIL_URL=https://einteilung.hochamt.at/verify-email
FRONTEND_RESET_PASSWORD_URL=https://einteilung.hochamt.at/reset-password

SHORTURL_DOMAIN=go.hochamt.at

# Koofr WebDAV backup -- reuse Legacy's EXISTING Koofr account credentials
# (same account/path as osa-einteilung.hochamt.at/config/filesystems.php's
# 'koofr_backup' disk), so scripts/backup_db.py/restore_db.py access the
# same backup history as osa-einteilung.hochamt.at/tools/
# restore-koofr-backup.sh -- though that script only recognizes backups
# created before 2026-08-13's stage-prefixed filename change (deliberate,
# accepted break, see backup_service.py's module docstring).
KOOFR_USER=
KOOFR_PASSWORD=

# Tier 2 -- safe to leave commented out (defaults match Legacy 1:1, see
# app/core/config.py's docstring for why these must not change casually).
# KOOFR_BASE_URI=https://app.koofr.net/dav/
# KOOFR_BACKUP_PATH=Koofr/Backups/osa-db
# KOOFR_BACKUP_RETENTION_DAYS=28
# BACKUP_ENABLED=true

# Tier 2 -- safe to leave commented out, but a DELIBERATE deviation from
# Legacy's dailyAt('10:50') (User decision, 2026-08-13): nighttime slot
# instead, Europe/Vienna wall-clock.
# BACKUP_HOUR=3
# BACKUP_MINUTE=0
