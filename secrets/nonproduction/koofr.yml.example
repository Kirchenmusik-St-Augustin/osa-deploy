# Template for secrets/nonproduction/koofr.yml -- copy, fill in, then
# `ansible-vault encrypt secrets/nonproduction/koofr.yml`. This .example
# file itself is safe to commit (no real secrets in it).
#
#   cp secrets/nonproduction/koofr.yml.example secrets/nonproduction/koofr.yml
#   $EDITOR secrets/nonproduction/koofr.yml
#   ansible-vault encrypt secrets/nonproduction/koofr.yml
#
# Loaded explicitly via `vars_files:` in playbooks/deploy.yml's play for
# every stage except production (test, qa), see
# secrets/production/koofr.yml.example for why it is not a group variable.

# Koofr WebDAV credentials of a second account that can only READ the
# production backup folder (the folder is shared with it read-only).
# Non-production stages only download the latest production backup
# (downsync); they never upload or delete, so a compromised test or qa host
# must not be able to touch the backups. Never put the production account
# here.
koofr_user: ""
koofr_password: ""
