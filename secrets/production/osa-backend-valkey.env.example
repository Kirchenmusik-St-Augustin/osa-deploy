# Template for secrets/<stage>/osa-backend-valkey.env -- copy, fill in a
# freshly generated password, then `ansible-vault encrypt
# secrets/<stage>/osa-backend-valkey.env`. This .example file itself is
# safe to commit (no real secrets in it).
#
#   cp secrets/production/osa-backend-valkey.env.example secrets/production/osa-backend-valkey.env
#   $EDITOR secrets/production/osa-backend-valkey.env
#   ansible-vault encrypt secrets/production/osa-backend-valkey.env
#
# Generate a fresh password per stage -- never reuse another stage's:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

VALKEY_PASSWORD=
