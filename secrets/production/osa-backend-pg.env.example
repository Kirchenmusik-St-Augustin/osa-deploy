# Template for secrets/<stage>/osa-backend-pg.env -- copy, fill in a
# freshly generated password, then `ansible-vault encrypt
# secrets/<stage>/osa-backend-pg.env`. This .example file itself is safe
# to commit (no real secrets in it).
#
#   cp secrets/production/osa-backend-pg.env.example secrets/production/osa-backend-pg.env
#   $EDITOR secrets/production/osa-backend-pg.env
#   ansible-vault encrypt secrets/production/osa-backend-pg.env
#
# Generate a fresh password per stage -- never reuse another stage's:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

POSTGRES_USER=osa
POSTGRES_PASSWORD=
POSTGRES_DB=osa
