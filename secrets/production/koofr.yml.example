# Template for secrets/production/koofr.yml -- copy, fill in, then
# `ansible-vault encrypt secrets/production/koofr.yml`. This .example file
# itself is safe to commit (no real secrets in it).
#
#   cp secrets/production/koofr.yml.example secrets/production/koofr.yml
#   $EDITOR secrets/production/koofr.yml
#   ansible-vault encrypt secrets/production/koofr.yml
#
# Loaded explicitly via `vars_files:` in playbooks/deploy.yml's play --
# deliberately NOT under inventory/group_vars/, which would apply to every
# host in the [vps] group regardless of which playbook is running (that
# used to make setup_vps.yml require a vault password too, even though it
# never references koofr_user/koofr_password at all). The play picks this
# file for the production stage and secrets/nonproduction/koofr.yml for
# every other stage.

# Koofr WebDAV backup credentials of the account that owns the backup
# folder: production writes the nightly dumps with it and prunes old ones.
# Defined here once instead of duplicated into the stage's
# secrets/production/osa-backend.env.j2. No other stage may receive these
# values, they can overwrite and delete every backup.
koofr_user: ""
koofr_password: ""
