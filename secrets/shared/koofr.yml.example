# Template for secrets/shared/koofr.yml -- copy, fill in, then
# `ansible-vault encrypt secrets/shared/koofr.yml`. This .example file
# itself is safe to commit (no real secrets in it).
#
#   cp secrets/shared/koofr.yml.example secrets/shared/koofr.yml
#   $EDITOR secrets/shared/koofr.yml
#   ansible-vault encrypt secrets/shared/koofr.yml
#
# Loaded explicitly via `vars_files:` in playbooks/deploy.yml's play --
# deliberately NOT under inventory/group_vars/, which would apply to every
# host in the [vps] group regardless of which playbook is running (that
# used to make setup_vps.yml require a vault password too, even though it
# never references koofr_user/koofr_password at all). One shared file
# instead of a per-stage copy either way -- deploy.yml's play targets
# every stage's host, so this loads once per run regardless of stage.

# Koofr WebDAV backup credentials -- ONE shared account/backup history
# across every stage, defined here once instead of duplicated into each
# stage's secrets/<stage>/osa-backend.env.j2.
koofr_user: ""
koofr_password: ""
