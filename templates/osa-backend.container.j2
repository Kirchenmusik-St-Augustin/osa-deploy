[Unit]
Description=OSA Backend API (Prod)

[Container]
ContainerName=osa-backend
Pod=osa-backend.pod
{# "latest" follows the nightly auto-update. Setting osa_backend_image_tag
   (inventory or -e) to a full commit SHA pins this container to one release;
   osa-backend-worker.container reads the same variable, so web and worker
   never run different versions while pinned. #}
Image=ghcr.io/kirchenmusik-st-augustin/osa-backend:{{ osa_backend_image_tag | default('latest') }}
# The unit counts as started only once the health check passes, so
# `podman auto-update` can see a broken new image and roll back to the
# previous one instead of leaving it in place.
Notify=healthy
AutoUpdate=registry
EnvironmentFile=%h/.env/osa-backend.env

ReadOnly=true
NoNewPrivileges=true
DropCapability=all
# The VPS this runs on has 1.9GB total RAM across all 7 application
# containers -- an unbounded container could starve every neighbor on an
# OOM event. 384m is ~2.7x the observed idle RSS (roughly 143MB across
# gunicorn's master + worker processes), enough headroom for request
# bursts without leaving the cap effectively meaningless. Quadlet 5.4.2's
# [Container] section has no native memory-limit key, so PodmanArgs= is
# the only way to reach --memory. 64 PIDs covers the gunicorn master/
# workers/threads with room to add workers later.
PodmanArgs=--memory=384m
PidsLimit=64
# gunicorn's worker heartbeat file (WorkerTmp) needs a writable /tmp it
# can create+unlink -- ReadOnlyTmpfs already defaults to true and would
# cover this on its own, but an explicit mount self-documents the
# requirement instead of relying on an implicit Podman default. noexec: on a
# read-only root this is the one writable location, and nothing executes from it.
Mount=type=tmpfs,target=/tmp,tmpfs-mode=1777,noexec
# gunicorn's --graceful-timeout (Dockerfile CMD) is 120s -- StopTimeout
# must exceed that so Podman doesn't SIGKILL the arbiter mid-grace-period.
# Must live here in [Container], not [Service]: that's the only section
# Quadlet translates into podman run's --stop-timeout flag. A [Service]-
# section StopTimeout= is passed through unvalidated and silently ignored
# by systemd (confirmed via `systemd-analyze verify`: "Unknown key
# 'StopTimeout' in section [Service], ignoring") -- it previously sat
# there and never actually took effect.
StopTimeout=150

HealthCmd=python3 -c 'import urllib.request; urllib.request.urlopen("http://localhost:8000/")'
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
# Must exceed [Container]'s StopTimeout=150 above so systemd doesn't kill
# the `podman rm` cleanup itself before Podman's own stop-timeout elapses.
# 30s buffer on top.
TimeoutStopSec=180
