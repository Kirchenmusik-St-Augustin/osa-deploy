[Unit]
Description=Podman garbage collector

[Service]
Type=oneshot
# Runs podman directly on the host as the "service" user - no container,
# so no podman-socket mount into a third-party image is needed for this
# (a socket mount would itself be an attack surface: whoever holds the
# socket controls every other rootless container this user runs).
#
# -a removes any image unused by a container, including one pre-pulled
# ahead of a planned Postgres major-version bump but not started yet --
# Podman has no "reserved for later" state a prune can respect, and no
# reliably supported filter closes that gap (verified live: the `until`
# filter matches an image's upstream build date, not when it was pulled
# onto this host, and `system prune` does not honor `reference!=` the way
# `image prune` does). See README.md's "Fresh or empty Postgres data
# directory" section for the operator-side workaround.
ExecStart=/usr/bin/podman system prune -a -f
