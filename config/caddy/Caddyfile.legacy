{
    email einteilung@hochamt.at
	# Deaktiviert HTTP/3 (QUIC) und nutzt nur TCP-basierte Protokolle
	servers {
		protocols h1 h2
	}
}

einteilung.hochamt.at {
        basic_auth /logging* {
                {$LOGGING_USER} {$LOGGING_PASSWORD_HASH}
        }
        handle /logging/dozzle* {
                reverse_proxy 127.0.0.1:8081
        }
        handle /logging/grafana* {
                reverse_proxy 127.0.0.1:3000
        }
        reverse_proxy 127.0.0.1:8080 {
                header_down -Server
        }
}

go.hochamt.at {
        reverse_proxy 127.0.0.1:8080 {
                header_down -Server
        }
}
