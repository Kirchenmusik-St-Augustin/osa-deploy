{
	email {{ acme_email | mandatory }}
	# The admin API would listen unauthenticated on the host's loopback
	# (the container uses the host network). The container is restarted,
	# never reloaded, so nothing needs it; the health check uses the
	# dedicated probe site below instead.
	admin off
	servers {
		# Disables HTTP/3 (QUIC), TCP-only.
		protocols h1 h2
		# Bounds slow-header / slow-body clients; no write timeout on purpose so
		# long-running responses are not cut off.
		timeouts {
			read_header 10s
			read_body 60s
			idle 2m
		}
	}
}

# Loopback-only probe for the container health check (the admin API is off).
http://127.0.0.1:2020 {
	bind 127.0.0.1
	respond /healthz "ok" 200
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# Keeps window.opener available for the Google sign-in popup while
		# still isolating the browsing context group from other origins.
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		# Also strip Caddy's own identifying header -- header_down below
		# only strips the upstream's.
		-Server
	}
}

# Content security policy of the single page application, sent in
# report-only mode: violations show up in the browser console without
# blocking anything. Switch the header name to Content-Security-Policy once
# the policy no longer reports false positives. Allowed outside origins: the
# Google sign-in script, button frame and styles. The fonts are served by the
# application itself.
(frontend_csp) {
	header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; font-src 'self'; img-src 'self' data: https://*.googleusercontent.com; connect-src 'self'{% if backend_domain != frontend_domain %} https://{{ backend_domain }}{% endif %} https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
}

# Rejects oversized request bodies at the edge with 413, in step with the
# backend's own limit (MAX_REQUEST_BODY_BYTES, 1 MiB by default). No endpoint
# accepts uploads.
(request_body_limit) {
	request_body {
		max_size 1MiB
	}
}

# Access log of every site. The reset and verification links carry a one-time
# token (and the address) in the query string, and the API calls the page makes
# afterwards repeat that address in the Referer header, so both are masked
# before a line is written; the log is readable through the log viewer.
(access_log) {
	log {
		format filter {
			wrap json
			request>uri query {
				replace token REDACTED
				delete email
			}
			request>headers>Referer regexp "([?&](?:token|email))=[^&]*" "${1}=REDACTED"
		}
	}
}

# Backend: prefix stripped, backend runs with root_path="/api".
# API answers carry personal data (user lists, new passwords) and must
# never be stored by a browser or proxy; header_down replaces any value
# the backend sends itself.
(backend_api) {
	handle_path /api {
		reverse_proxy 127.0.0.1:21000 {
			header_down -Server
			header_down Cache-Control "no-store"
		}
	}
	handle_path /api/* {
		reverse_proxy 127.0.0.1:21000 {
			header_down -Server
			header_down Cache-Control "no-store"
		}
	}
}

# The single page application: security policy plus the frontend upstream.
(frontend_app) {
	import frontend_csp
	reverse_proxy 127.0.0.1:21001 {
		header_down -Server
	}
}

# Compat redirect: hochamt.at/go/{path} existed before the dedicated
# go.-subdomain below and redirected there too.
(go_redirect) {
	handle_path /go/* {
		redir https://{{ shorturl_domain }}{uri} 302
	}
}

{% if backend_domain == frontend_domain %}
{{ backend_domain }} {
	import security_headers
	import request_body_limit
	import access_log
	import go_redirect
	import backend_api
	# Frontend: catch-all fallback.
	handle {
		import frontend_app
	}
}
{% else %}
{{ backend_domain }} {
	import security_headers
	import request_body_limit
	import access_log
	import go_redirect
	import backend_api
	# Dedicated backend domain -- no frontend fallback here, it lives on
	# frontend_domain below.
	handle {
		respond "Not Found" 404
	}
}

{{ frontend_domain }} {
	import security_headers
	import access_log
	import frontend_app
}
{% endif %}

# Log viewer on a name of its own: protected by basic auth and, when the
# inventory variable logging_allowed_cidrs lists networks, reachable from those
# networks only. The route block keeps the written order, so the network check
# answers 403 before the credentials are examined and a client outside the
# allowed networks cannot tell a wrong password from a right one.
{{ logging_domain | mandatory }} {
	import security_headers
	import access_log
	route {
{% if logging_allowed_cidrs | default([]) %}
		@outside_allowlist not remote_ip {{ logging_allowed_cidrs | join(' ') }}
		respond @outside_allowlist 403
{% endif %}
		basic_auth {
			{$LOGGING_USER} {$LOGGING_PASSWORD_HASH}
		}
		reverse_proxy 127.0.0.1:8081 {
			header_down -Server
		}
	}
}

# Short-URL redirect service on its own subdomain. `rewrite` prepends "/go" to
# every request before it reaches the same backend port as above -- the
# inverse of the "/api" prefix-stripping pattern: the public go-router is
# mounted in the backend under exactly this prefix (main.py), but is not
# reachable via the main domain above (only /api/* is routed to the backend
# there). Public and unauthenticated -- a pure redirect service.
{{ shorturl_domain }} {
	import security_headers
	import request_body_limit
	import access_log
	rewrite * /go{uri}
	reverse_proxy 127.0.0.1:21000 {
		header_down -Server
	}
}
{% if augustiner_domain is defined %}

# Static website of the Augustinian church: a third-party repository that
# augustiner-pull.timer mirrors into ~/data/augustiner/site, mounted read-only.
# It brings its own content security policy as a <meta> tag in every page, so
# none of the application snippets above apply here.
{% if augustiner_stats_domain is defined %}
# Source of the visitor statistics: every name of the website also writes its
# requests to a file of their own, in addition to the usual access log above.
# The statistics jobs (quadlets/augustiner-stats/) read it every hour. Caddy
# rolls the file by size only; the small size makes it roll often enough that
# roll_keep_for really removes full addresses after seven days, and roll_keep
# is high enough never to drop a file sooner.
(augustiner_log) {
	log augustiner_statistics {
		output file /var/log/augustiner/access.log {
			roll_size 1MiB
			roll_keep 5000
			roll_keep_for 168h
		}
		format json
	}
}

{% endif %}
(augustiner_headers) {
	header {
		# Without includeSubDomains: the stage only answers for this one name.
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}
}

{{ augustiner_domain }} {
	import augustiner_headers
	import access_log
{% if augustiner_stats_domain is defined %}
	import augustiner_log
{% endif %}
{% if augustiner_noindex | default(true) | bool %}
	# Interim domain: keeps search engines from indexing a copy of the site.
	header X-Robots-Tag "noindex, nofollow, noarchive"
{% endif %}
	root * /srv/augustiner/site
	encode zstd gzip

	# Every response is revalidated by ETag (304 when unchanged), so a
	# replaced file shows up at once. Media may sit in shared caches, the
	# data tables only in the browser. The data tables are what the pages
	# load by script, not pages of their own, so they stay out of search
	# results; the pages that show them are indexed.
	@media path_regexp (?i)\.(?:webp|png|jpe?g|gif|svg|ico|mp3|m4a|ogg|mp4|webm)$
	@data {
		path /data/*
		not path_regexp (?i)\.(?:webp|png|jpe?g|gif|svg|ico|mp3|m4a|ogg|mp4|webm)$
	}
	header @media Cache-Control "public, no-cache"
	header @data Cache-Control "private, no-cache"
	header @data X-Robots-Tag "noindex"
	header ?Cache-Control "no-cache"

	@csv path *.csv
	header @csv Content-Type "text/csv; charset=utf-8"
	@manifest path /site.webmanifest
	header @manifest Content-Type "application/manifest+json"

	route {
		@not_read not method GET HEAD
		respond @not_read 405

		# Earlier addresses of the translated pages.
		@old_index path_regexp old_index ^/index\.(en|it|fr|es)\.html$
		redir @old_index /{re.old_index.1}/index.html permanent
		@old_page path_regexp old_page ^/pages/([a-z-]+)\.(en|it|fr|es)\.html$
		redir @old_page /{re.old_page.2}/pages/{re.old_page.1}.html permanent

		# Allowlist: only the paths of the published website. Everything
		# else in the repository, the .git directory and the browser-side
		# administration stay unreachable, including anything added to the
		# repository later.
		@outside_package not path / /index.html /favicon.ico /site.webmanifest /sw.js /offline.html /sitemap.xml /robots.txt /en /it /fr /es /pages/* /en/* /it/* /fr/* /es/* /css/* /js/* /assets/* /data/*
		respond @outside_package 404
		@admin_only path_regexp (?i)^/(?:css/admin|js/admin|pages/[^/]*-verwaltung\.html$)
		respond @admin_only 404
		@hidden path_regexp (?i)/(?:\.|~\$|thumbs\.db$|desktop\.ini$)
		respond @hidden 404
		@leftovers path_regexp (?i)(?:~|\.(?:bak|tmp|crswap|swp|log|md|py|sh|conf|sha256|tar|gz|zip))$
		respond @leftovers 404

		file_server
	}

	# A missing file is an error of file_server, and Caddy drops the deferred
	# header block on that path (the `-Server` deletion defers it). The
	# answer keeps its real status, so search engines see a plain 404.
	handle_errors {
		import augustiner_headers
		respond "{err.status_code} {err.status_text}"
	}
}
{% if augustiner_alias_domains | default([]) %}

# Further names of the same website: permanent redirect to the main domain,
# path and query kept.
{{ augustiner_alias_domains | join(', ') }} {
	import access_log
{% if augustiner_stats_domain is defined %}
	import augustiner_log
{% endif %}
	header -Server
	redir https://{{ augustiner_domain }}{uri} permanent
}
{% endif %}
{% if augustiner_redirects | default({}) %}

# Names of their own that lead to one page of the website: permanent
# redirect to that fixed address, one block per target page. Search engines
# move the old entries over to the target; browsers keep the redirect for one
# day only, so a later change of the target reaches every visitor soon.
{% for target, names in augustiner_redirects | dict2items | groupby('value') %}
{% if not loop.first %}

{% endif %}
{{ names | map(attribute='key') | join(', ') }} {
	import access_log
{% if augustiner_stats_domain is defined %}
	import augustiner_log
{% endif %}
	header -Server
	header Cache-Control "max-age=86400"
	redir https://{{ augustiner_domain }}{{ target }} 301
}
{% endfor %}
{% endif %}
{% if augustiner_stats_domain is defined %}

# Visitor statistics of the website: static pages that the statistics jobs
# write into ~/data/augustiner-stats/www, mounted read-only. The login is the
# one of the log viewer (LOGGING_USER and LOGGING_PASSWORD_HASH in caddy.env).
# The `-Server` deletion defers the whole header block, and deferred headers
# are lost when basic_auth answers 401 or a file is missing, so handle_errors
# sets them again.
(augustiner_stats_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		X-Robots-Tag "noindex, nofollow, noarchive"
		Cache-Control "no-store"
		-Server
	}
}

{{ augustiner_stats_domain }} {
	import augustiner_stats_headers
	import access_log
	encode zstd gzip

	# The dashboard is drawn without any script. Only the two GoAccess
	# reports need theirs: inline code, templates compiled at runtime
	# ('unsafe-eval') and the panel names in automatisch.js ('self').
	@detail path /menschen.html /automatisch.html
	@overview not path /menschen.html /automatisch.html
	header @overview Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
	header @detail Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'unsafe-inline'; img-src data:; font-src data:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"

	# The credentials come first, so a request without them learns nothing
	# but 401, whatever its method or path.
	route {
		basic_auth {
			{$LOGGING_USER} {$LOGGING_PASSWORD_HASH}
		}
		@not_read not method GET HEAD
		respond @not_read 405
		root * /srv/augustiner-stats
		file_server
	}

	handle_errors {
		import augustiner_stats_headers
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		respond "{err.status_code} {err.status_text}"
	}
}
{% endif %}
{% endif %}
