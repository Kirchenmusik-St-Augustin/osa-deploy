# Template for secrets/osa-backend-valkey.env -- copy, fill in a
# freshly generated password, then encrypt it. This .example file itself is
# safe to commit (no real secrets in it).
#
#   cp secrets/osa-backend-valkey.env.example secrets/osa-backend-valkey.env
#   $EDITOR secrets/osa-backend-valkey.env
#   ./osa vault <stage> encrypt secrets/osa-backend-valkey.env
#
# Generate a fresh password per stage -- never reuse another stage's:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

VALKEY_PASSWORD=
