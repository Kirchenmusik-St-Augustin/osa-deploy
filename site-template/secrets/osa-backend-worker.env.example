# Template for secrets/osa-backend-worker.env -- environment that only the
# worker container receives (in addition to osa-backend.env): the Koofr
# WebDAV credentials of the backup and downsync jobs. The web container never
# reads this file. Copy it, fill in the values, then encrypt it. This
# .example file itself is safe to commit (no real secrets in it).
#
#   cp secrets/osa-backend-worker.env.example secrets/osa-backend-worker.env
#   $EDITOR secrets/osa-backend-worker.env
#   ./osa vault <stage> encrypt secrets/osa-backend-worker.env
#
# Production: the account that owns the backup folder. It writes the
# nightly dumps and prunes old ones.
# Every other stage (test, qa): a second account that can only READ the
# production backup folder (the folder is shared with it read-only).
# Non-production stages only download the latest production backup
# (downsync), so a compromised test or qa host must not be able to
# overwrite or delete the backups. Never put the production account into
# the file of another stage.
KOOFR_USER=
KOOFR_PASSWORD=

# Tier 2 -- safe to leave commented out (the commented values are the
# built-in defaults). Changing the base URI or path orphans the backups
# already stored on Koofr -- see app/core/config.py. A non-production stage
# sets KOOFR_BACKUP_PATH to the path under which its read-only account sees
# the shared production backup folder, if that differs from the default.
# KOOFR_BASE_URI=https://app.koofr.net/dav/
# KOOFR_BACKUP_PATH=Koofr/Backups/osa-db
# KOOFR_BACKUP_RETENTION_DAYS=28
