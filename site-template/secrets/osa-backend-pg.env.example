# Template for secrets/osa-backend-pg.env -- copy, fill in a
# freshly generated password, then encrypt it. This .example file itself is safe
# to commit (no real secrets in it).
#
#   cp secrets/osa-backend-pg.env.example secrets/osa-backend-pg.env
#   $EDITOR secrets/osa-backend-pg.env
#   ./osa vault <stage> encrypt secrets/osa-backend-pg.env
#
# Generate a fresh password per stage -- never reuse another stage's:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# POSTGRES_USER is the bootstrap role (always a superuser): administration
# only. The backend connects as osa_app, whose password is the one in
# DATABASE_URL of secrets/osa-backend.env.j2.
POSTGRES_USER=osa
POSTGRES_PASSWORD=
POSTGRES_DB=osa
