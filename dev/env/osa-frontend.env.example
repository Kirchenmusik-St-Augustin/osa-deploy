# Template for local dev's ~/.env/osa-frontend.env -- copy, fill in, keep
# private.
#
#   install -d -m 700 ~/.env
#   cp dev/env/osa-frontend.env.example ~/.env/osa-frontend.env
#   $EDITOR ~/.env/osa-frontend.env
#   chmod 600 ~/.env/osa-frontend.env
VITE_APP_ENVIRONMENT=development

# Absolute URL, not the relative "/api" the app normally recommends -- the
# Vite dev server itself doesn't do the /api path split, only your local
# Caddy in front of it does (see this repo's README).
VITE_API_BASE_URL=https://<your-dev-domain>/api

# Host names the Vite dev server accepts besides localhost, comma-separated.
# Set the public dev domain your Caddy passes through to the dev server;
# without it Vite answers that domain with 403 (blocked request).
VITE_DEV_ALLOWED_HOSTS=<your-dev-domain>

# Same value as osa-backend.env's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
