# Template for local dev's ~/.env/osa-frontend.env -- copy, fill in, keep
# private.
VITE_APP_ENVIRONMENT=development

# Absolute URL, not the relative "/api" the app normally recommends -- the
# Vite dev server itself doesn't do the /api path split, only your local
# Caddy in front of it does (see this repo's README).
VITE_API_BASE_URL=https://<your-dev-domain>/api

# Same value as osa-backend.env's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
