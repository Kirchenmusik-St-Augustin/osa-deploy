# Template for local dev's ~/.env/osa-backend-pg.env -- copy, fill in
# freshly generated passwords, keep private.
#
#   install -d -m 700 ~/.env
#   cp dev/env/osa-backend-pg.env.example ~/.env/osa-backend-pg.env
#   $EDITOR ~/.env/osa-backend-pg.env
#   chmod 600 ~/.env/osa-backend-pg.env
#
# Generate each password with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

POSTGRES_DB=osa
# POSTGRES_USER is the bootstrap role (always a superuser): administration
# only, the backend never connects with it.
POSTGRES_USER=osa
POSTGRES_PASSWORD=
# Password of the non-superuser role osa_app that the backend connects as
# (DATABASE_URL in osa-backend.env). Generate a different one than above.
OSA_APP_PASSWORD=
