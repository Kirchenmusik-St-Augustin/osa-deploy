# Template for local dev's ~/.env/osa-backend-pg.env -- copy, fill in a
# freshly generated password, keep private.
POSTGRES_DB=osa
# POSTGRES_USER is the bootstrap role (always a superuser): administration
# only, the backend never connects with it.
POSTGRES_USER=osa
POSTGRES_PASSWORD=
# Password of the non-superuser role osa_app that the backend connects as
# (DATABASE_URL in osa-backend.env). Generate a different one than above.
OSA_APP_PASSWORD=
