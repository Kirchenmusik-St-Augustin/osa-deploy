# Template for local dev's ~/.env/osa-backend.env -- copy, fill in, keep
# private (never commit the real file, it holds live secrets).
#
#   mkdir -p ~/.env
#   cp dev/env/osa-backend.env.example ~/.env/osa-backend.env
#   $EDITOR ~/.env/osa-backend.env
#   chmod 600 ~/.env/osa-backend.env

APP_ENVIRONMENT=development
APP_TIMEZONE=Europe/Vienna

# Must match whatever domain you route through your local Caddy -- see the
# "Local development environment" section of this repo's README.
CORS_ORIGINS=https://<your-dev-domain>

# osa-backend runs in the same pod network namespace as osa-backend-pg,
# so it reaches Postgres on its container-internal port (5432, Postgres'
# own default) -- NOT on osa-backend.pod.example's host-published port
# (5433 by default), which is only reachable from outside the pod (e.g.
# psql run directly on the host).
DATABASE_URL=postgresql://osa:CHANGEME@127.0.0.1:5432/osa

# Same pod-internal reasoning as DATABASE_URL above -- osa-backend-valkey
# is reachable on its container-internal default port. Password must
# match ~/.env/osa-backend-valkey.env's VALKEY_PASSWORD.
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
VALKEY_PASSWORD=CHANGEME

# JWT signing secret -- generate a fresh one, never reuse production's.
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Public OAuth client ID, shared across all stages including dev -- not a
# secret in the traditional sense, but still project config. Retrieve it
# with (vault password needed):
#   ansible-vault view secrets/production/osa-backend.env.j2
GOOGLE_CLIENT_ID=

# Needed only to downsync a production data snapshot into this dev DB (see
# README). Leave blank if you don't have Koofr credentials yet -- the
# backend starts fine without them, downsync/restore just won't work.
KOOFR_USER=
KOOFR_PASSWORD=

# Independent of <your-dev-domain> above -- production's shorturl_domain
# is its own inventory variable too, not derived from backend_domain/
# frontend_domain (see "Stages" above). Often "go." + your main dev
# domain, but doesn't have to be.
SHORTURL_DOMAIN=<your-shorturl-domain>

# Optional -- point at a local mail-catcher if you want to see outgoing
# mail during dev. Leave both blank/commented to let mail sending fail
# silently/harmlessly, same as any other non-production stage.
# SMTP_HOST=
# SMTP_PORT=

FRONTEND_VERIFY_EMAIL_URL=https://<your-dev-domain>/verify-email
FRONTEND_RESET_PASSWORD_URL=https://<your-dev-domain>/reset-password

# Dev/test-only -- consumed by osa-backend's pytest suite
# (podman exec osa-backend pytest ...), not by the running container.
TEST_DATABASE_URL=postgresql://osa:CHANGEME@127.0.0.1:5432/osa_test
