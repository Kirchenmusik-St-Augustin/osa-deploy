# Template for local dev's ~/.env/osa-backend-valkey.env -- copy, fill in
# a freshly generated password, keep private.
#
#   install -d -m 700 ~/.env
#   cp dev/env/osa-backend-valkey.env.example ~/.env/osa-backend-valkey.env
#   $EDITOR ~/.env/osa-backend-valkey.env
#   chmod 600 ~/.env/osa-backend-valkey.env
#
# Generate the password with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

VALKEY_PASSWORD=
