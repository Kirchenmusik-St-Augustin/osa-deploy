# Local-dev Caddy vhosts for OSA -- append to your own host-wide Caddyfile
# (not containerized/Ansible-managed in dev, see this repo's README).
# Replace <your-dev-domain> with whatever domain you point at this
# machine, and <your-shorturl-domain> below with your shorturl domain --
# the two are independent, not one derived from the other (matching
# production's own backend_domain/frontend_domain/shorturl_domain split,
# see the "Stages" section of this repo's README).
#
# Replace <your-allowed-cidrs> with the space-separated networks that may
# reach the dev stage (for example "203.0.113.0/24 198.51.100.7/32"). The dev
# database is refreshed nightly from a production snapshot and the Vite dev
# server exposes source files, so neither may be open to the whole internet.

<your-dev-domain> {
	@allowed remote_ip <your-allowed-cidrs>
	handle @allowed {
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
		}
		handle_path /api {
			reverse_proxy 127.0.0.1:21000
		}
		handle_path /api/* {
			reverse_proxy 127.0.0.1:21000
		}
		handle {
			reverse_proxy 127.0.0.1:21001
		}
	}
	handle {
		respond "Forbidden" 403
	}
}

# Optional -- only needed if you also want to test short-URL redirects
# locally. Public by design (a redirect service), so no allow-list here.
<your-shorturl-domain> {
	rewrite * /go{uri}
	reverse_proxy 127.0.0.1:21000
}
