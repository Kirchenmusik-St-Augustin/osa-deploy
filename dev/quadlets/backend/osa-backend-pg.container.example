[Unit]
Description=PostgreSQL for OSA Backend (Dev)

[Container]
ContainerName=osa-backend-pg
Pod=osa-backend.pod
# Deliberately a floating major-version tag, unlike quadlets/backend's
# production equivalent (pinned to tag@digest there): dev machines don't
# run podman-auto-update.timer, so nothing here pulls or restarts this
# container unattended -- AutoUpdate=registry only ever takes effect on an
# explicit `podman auto-update` a developer runs themselves, and the
# blast radius of a bad pull is the local dev database, not the
# production system. An intentional simplification, not an oversight.
Image=docker.io/library/postgres:18
AutoUpdate=registry
EnvironmentFile=%h/.env/osa-backend-pg.env
# Holds the nightly production snapshot (downsync), so it is hardened like
# production. The entrypoint starts as root to chown the data directory and
# then drops to the postgres user, which needs exactly these capabilities.
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
AddCapability=CHOWN DAC_OVERRIDE FOWNER SETGID SETUID
PodmanArgs=--memory=384m
PidsLimit=150
Volume=%h/data/osa-backend/postgres:/var/lib/postgresql:Z
# Creates the non-superuser application role on the first start with an empty
# data directory (see the README for migrating an existing one).
Volume=%h/projects/osa-fastapi-vue/osa-deploy/dev/postgres-init:/docker-entrypoint-initdb.d:ro,Z

HealthCmd=pg_isready -U osa -d osa || exit 1
HealthInterval=10s
HealthTimeout=10s
HealthStartPeriod=15s
HealthRetries=3

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=default.target
