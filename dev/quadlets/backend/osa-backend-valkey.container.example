[Unit]
Description=Valkey Queue Backend for OSA Backend ARQ Worker (Dev)

[Container]
ContainerName=osa-backend-valkey
Pod=osa-backend.pod
# Deliberately a floating major-version tag -- same reasoning as
# osa-backend-pg.container.example: no podman-auto-update.timer runs on
# dev machines, and the blast radius of a bad pull is the local dev queue,
# not the production system. An intentional simplification, not an
# oversight.
Image=docker.io/valkey/valkey:8-alpine
AutoUpdate=registry
EnvironmentFile=%h/.env/osa-backend-valkey.env
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
Volume=%h/data/osa-backend/valkey:/data:Z
# See templates/osa-backend-valkey.container.j2 for why this needs the sh -c
# wrapper (Quadlet's Exec= doesn't expand env vars) and why that's fine
# without any extra ownership-fix step here too. A generated config file in
# a private tmpfs keeps the password out of every process's argv. "%%s" is
# systemd's escape for a literal percent sign. U=true hands the tmpfs to the
# container's user: the pod runs with UserNS=keep-id, so the process is not
# the container's root and could not write into a root-owned tmpfs.
Mount=type=tmpfs,target=/tmp,tmpfs-mode=1700,U=true
Exec=sh -c 'umask 077 && printf "requirepass %%s\nappendonly yes\n" "$VALKEY_PASSWORD" > /tmp/valkey.generated.conf && exec valkey-server /tmp/valkey.generated.conf'

# REDISCLI_AUTH keeps the password out of this process's argv. valkey-cli exits
# 0 even when the server answers with NOAUTH/WRONGPASS, so the reply itself
# has to be checked: only a real PONG proves the password is the right one.
HealthCmd=REDISCLI_AUTH="$VALKEY_PASSWORD" valkey-cli ping | grep -qx PONG
HealthInterval=10s
HealthTimeout=5s
HealthStartPeriod=10s
HealthRetries=3

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
